# Password for /admin (required to use the admin form)
ADMIN_PASSWORD=change-me-to-something-long

# GitHub fine-grained token with "Contents: Read and write" on this repo only.
# The admin form commits your edits through it; Vercel then redeploys.
GITHUB_TOKEN=

# Optional. On Vercel these default to the repo/branch the site was deployed from.
# GITHUB_REPO=owner/repo
# GITHUB_BRANCH=main

# Optional. Enables "AI draft from documents" (fills project fields from your uploaded docs).
# Free: Google Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Paid alternative (used only if GEMINI_API_KEY is empty):
ANTHROPIC_API_KEY=
